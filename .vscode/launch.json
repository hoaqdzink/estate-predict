{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Chạy file đang mở",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Mở ứng dụng Streamlit",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "app/streamlit_app.py"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Mở web Django",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/web/manage.py",
      "args": [
        "runserver",
        "127.0.0.1:8000"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "django": true
    }
  ]
}